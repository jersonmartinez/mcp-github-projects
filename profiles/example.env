# ── Example Profile ──────────────────────────────────────────────────────────
# Copy this file as .env in the MCP root and fill in your values.
#
# Usage:
#   cp profiles/example.env .env
#
# Required variables (server will not start without these):

GH_PROJECT_ORG_NAME=your-org-or-username
GH_PROJECT_REPO_NAME=your-repo
GH_PROJECT_PROJECT_NUMBER=1

# Owner type: 'organization' (default) or 'user' (for personal projects)
GH_PROJECT_OWNER_TYPE=organization

# ── Optional overrides ───────────────────────────────────────────────────────
# GH_PROJECT_TIMEOUT_SECONDS=10
# GH_PROJECT_RETRY_ATTEMPTS=1
# GH_PROJECT_CACHE_TTL_HOURS=24
# GH_PROJECT_MAX_ITEMS=200

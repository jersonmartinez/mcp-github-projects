# ── User Example Profile ─────────────────────────────────────────────────────
# Example multi-target profile for a user-owned project.
#
# Usage:
#   GH_PROJECT_PROFILE=user-example python server.py
#
# IMPORTANT: Never place token values in profile files.
# Tokens are resolved from GITHUB_TOKEN / GH_TOKEN env vars or `gh auth token`.

GH_PROJECT_ORG_NAME=octocat
GH_PROJECT_REPO_NAME=hello-world
GH_PROJECT_PROJECT_NUMBER=1
GH_PROJECT_OWNER_TYPE=user
